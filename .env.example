# Copie para .env.local e preencha.
# Local (supabase start): os valores aparecem no terminal.
# Nuvem: Supabase > Project Settings > API.
# Servidor próprio: URL e chaves do Supabase self-hosted.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Nunca exponha no front-end. Usada só em código de servidor.
SUPABASE_SECRET_KEY=

# Assistente Bunker (BUNKER CHAT). Sem a chave, o assistente fica desligado.
ANTHROPIC_API_KEY=
ASSISTENTE_MODELO=claude-haiku-5-5

# Dados da agência usados nos contratos
AGENCIA_NOME="GO Bunker! Mídia e Tecnologia"
AGENCIA_DOCUMENTO=
AGENCIA_ENDERECO=
AGENCIA_CIDADE_FORO="Aparecida de Goiânia/GO"
